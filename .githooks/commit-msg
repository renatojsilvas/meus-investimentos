#!/bin/sh
# Bloqueia commits com trailer de atribuição à IA (Co-Authored-By, Generated
# with/by), sem distinção de caixa. Ativação (uma vez por clone):
#   git config core.hooksPath .githooks

msg_file="$1"

if grep -qiE "Co-Authored-By|Generated with|Generated by" "$msg_file"; then
    echo "commit-msg: mensagem contém trailer de atribuição à IA — commit bloqueado." >&2
    exit 1
fi

exit 0
