@page "/lancar"
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@inject CarteiraDbContext Db
@inject Importacao Importacao

<p><a href="/carteira">Carteira</a></p>

<h3>Lançar operação</h3>

@if (_mensagemSucesso is not null)
{
    <p><strong>@_mensagemSucesso</strong></p>
}
@if (_mensagemErro is not null)
{
    <p><strong>Erro:</strong> @_mensagemErro</p>
}

<EditForm Model="_form" OnSubmit="Salvar">
    <div>
        <label>Titular</label>
        <select @bind="_form.TitularSlug">
            <option value="">-- selecione --</option>
            @foreach (var t in _titulares)
            {
                <option value="@t.Slug">@t.Nome</option>
            }
        </select>
    </div>

    <div>
        <label>Título</label>
        <select @bind="_form.AtivoCodigo">
            <option value="">-- selecione --</option>
            @foreach (var a in _ativos)
            {
                <option value="@a.Codigo">@a.Nome (@NomeClasse(a.Classe))</option>
            }
            <option value="@OutroValor">outro</option>
        </select>
    </div>

    <div>
        <label>Classe</label>
        <select @bind="_form.ClasseNova" disabled="@(_form.AtivoCodigo != OutroValor)">
            <option value="TESOURO">Tesouro</option>
            <option value="RENDA_FIXA">Renda fixa</option>
            <option value="ACAO">Ação</option>
            <option value="FII">FII</option>
        </select>
    </div>
    <div>
        <label>Código</label>
        <input type="text" @bind="_form.CodigoNovo" disabled="@(_form.AtivoCodigo != OutroValor)" />
    </div>
    <div>
        <label>Nome</label>
        <input type="text" @bind="_form.TituloNovo" disabled="@(_form.AtivoCodigo != OutroValor)" />
    </div>
    <div>
        <label>Vencimento</label>
        <input type="text" @bind="_form.VencimentoNovo" disabled="@(_form.AtivoCodigo != OutroValor || _form.ClasseNova is "ACAO" or "FII")" placeholder="dd/MM/yyyy" />
    </div>

    <div>
        <label>Data</label>
        <input type="date" value="@_form.Data" @onchange="@((ChangeEventArgs e) => _form.Data = e.Value?.ToString() ?? "")" />
    </div>

    <div>
        <label>Tipo</label>
        <select @bind="_form.Tipo">
            <option value="APLICACAO">Aplicação</option>
            <option value="RESGATE">Resgate</option>
            <option value="DESDOBRAMENTO">Desdobramento</option>
            <option value="GRUPAMENTO">Grupamento</option>
            <option value="BONIFICACAO">Bonificação</option>
        </select>
    </div>

    <div>
        <label>@RotuloQuantidade</label>
        <input type="text" @bind="_form.Quantidade" />
    </div>
    <div>
        <label>PU</label>
        <input type="text" @bind="_form.Preco" disabled="@(_form.Tipo is "DESDOBRAMENTO" or "GRUPAMENTO")" />
    </div>
    <div>
        <label>Taxas</label>
        <input type="text" @bind="_form.Taxas" />
    </div>

    <button type="submit">Lançar</button>
</EditForm>

<h3>Atualizar PU</h3>

@if (_puSucesso is not null)
{
    <p><strong>@_puSucesso</strong></p>
}
@if (_puErro is not null)
{
    <p><strong>Erro:</strong> @_puErro</p>
}

<EditForm Model="_pu" OnSubmit="SalvarPu">
    <div>
        <label>Título</label>
        <select @bind="_pu.Codigo">
            <option value="">-- selecione --</option>
            @foreach (var a in _ativos)
            {
                <option value="@a.Codigo">@a.Nome (@NomeClasse(a.Classe))</option>
            }
        </select>
    </div>
    <div>
        <label>PU</label>
        <input type="text" @bind="_pu.Valor" />
    </div>
    <div>
        <label>Data</label>
        <input type="date" value="@_pu.Data" @onchange="@((ChangeEventArgs e) => _pu.Data = e.Value?.ToString() ?? "")" />
    </div>
    <button type="submit">Gravar PU</button>
</EditForm>

<h4>Últimos PUs manuais</h4>
<table border="1">
    <thead>
        <tr>
            <th>Data</th>
            <th>Título</th>
            <th>PU</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in _precosManuais)
        {
            <tr>
                <td>@p.Data.ToString("dd/MM/yyyy", Formato.Cultura)</td>
                <td>@NomeAtivo(p.AtivoId)</td>
                <td>@Formato.Moeda(p.PrecoUnitario)</td>
            </tr>
        }
    </tbody>
</table>

<h4>Últimas operações</h4>
<table border="1">
    <thead>
        <tr>
            <th>Data</th>
            <th>Titular</th>
            <th>Título</th>
            <th>Tipo</th>
            <th>Quantidade</th>
            <th>PU</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var o in _operacoes)
        {
            <tr>
                <td>@o.Data.ToString("dd/MM/yyyy", Formato.Cultura)</td>
                <td>@NomeTitular(o.TitularId)</td>
                <td>@NomeAtivo(o.AtivoId)</td>
                <td>@o.Tipo</td>
                <td>@Formato.Numero(o.Quantidade)</td>
                <td>@Formato.Moeda(o.PrecoUnitario)</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private const string OutroValor = "outro";

    private FormularioLancamento _form = new();
    private List<Titular> _titulares = [];
    private List<Ativo> _ativos = [];
    private List<Operacao> _operacoes = [];
    private List<PrecoDiario> _precosManuais = [];
    private FormularioPu _pu = new() { Data = Relogio.HojeSaoPaulo().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) };
    private string? _puSucesso;
    private string? _puErro;
    private string? _mensagemSucesso;
    private string? _mensagemErro;

    protected override async Task OnInitializedAsync()
    {
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        _titulares = await Db.Titulares.OrderBy(t => t.Nome).ToListAsync();
        _ativos = await Db.Ativos.OrderBy(a => a.Nome).ToListAsync();
        _operacoes = await Db.Operacoes.OrderByDescending(o => o.Data).Take(20).ToListAsync();
        _precosManuais = await Db.PrecosDiarios
            .Where(p => Db.Ativos.Any(a => a.Id == p.AtivoId && a.Classe == ClasseAtivo.RendaFixa))
            .OrderByDescending(p => p.Data)
            .Take(10)
            .ToListAsync();
    }

    private async Task Salvar()
    {
        string codigo, titulo, vencimento;
        string? classe = null;
        if (_form.AtivoCodigo == OutroValor)
        {
            codigo = _form.CodigoNovo.Trim();
            titulo = _form.TituloNovo.Trim();
            vencimento = _form.VencimentoNovo.Trim();
            classe = _form.ClasseNova;
        }
        else
        {
            var ativo = _ativos.FirstOrDefault(a => a.Codigo == _form.AtivoCodigo);
            codigo = ativo?.Codigo ?? "";
            titulo = ativo?.Nome ?? "";
            classe = ativo is null ? null : NomeClasseCsv(ativo.Classe);
            vencimento = ativo?.Vencimento?.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture) ?? "";
        }

        var dataTexto = DateOnly.TryParseExact(_form.Data, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var data)
            ? data.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)
            : _form.Data;

        var req = new OperacaoRequest(dataTexto, _form.TitularSlug, codigo, titulo, vencimento, _form.Tipo, _form.Quantidade.Trim(), _form.Preco.Trim(), _form.Taxas.Trim(), classe);

        try
        {
            await Importacao.LancarAsync(req, CancellationToken.None);
            _mensagemSucesso = "Operação lançada";
            _mensagemErro = null;
            _form = new FormularioLancamento();
            await CarregarAsync();
        }
        catch (ImportacaoInvalidaException ex)
        {
            _mensagemErro = ex.Message;
            _mensagemSucesso = null;
        }
    }

    private async Task SalvarPu()
    {
        var dataTexto = DateOnly.TryParseExact(_pu.Data, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var data)
            ? data.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)
            : _pu.Data;

        try
        {
            await Importacao.GravarPrecoAsync(new PrecoRequest(_pu.Codigo, dataTexto, _pu.Valor.Trim()), CancellationToken.None);
            _puSucesso = "PU gravado";
            _puErro = null;
            _pu = new FormularioPu { Data = _pu.Data };
            await CarregarAsync();
        }
        catch (ImportacaoInvalidaException ex)
        {
            _puErro = ex.Message;
            _puSucesso = null;
        }
    }

    private string RotuloQuantidade => _form.Tipo switch
    {
        "DESDOBRAMENTO" or "BONIFICACAO" => "Unidades recebidas",
        "GRUPAMENTO" => "Unidades retiradas",
        _ => "Quantidade"
    };

    private static string NomeClasse(ClasseAtivo classe) => classe switch
    {
        ClasseAtivo.RendaFixa => "Renda fixa",
        ClasseAtivo.Acao => "Ação",
        ClasseAtivo.Fii => "FII",
        _ => "Tesouro"
    };

    private static string NomeClasseCsv(ClasseAtivo classe) => classe switch
    {
        ClasseAtivo.RendaFixa => "RENDA_FIXA",
        ClasseAtivo.Acao => "ACAO",
        ClasseAtivo.Fii => "FII",
        _ => "TESOURO"
    };

    private string NomeTitular(Guid id) => _titulares.FirstOrDefault(t => t.Id == id)?.Nome ?? "?";
    private string NomeAtivo(Guid id) => _ativos.FirstOrDefault(a => a.Id == id)?.Nome ?? "?";

    private class FormularioPu
    {
        public string Codigo { get; set; } = "";
        public string Valor { get; set; } = "";
        public string Data { get; set; } = "";
    }

    private class FormularioLancamento
    {
        public string TitularSlug { get; set; } = "";
        public string AtivoCodigo { get; set; } = "";
        public string CodigoNovo { get; set; } = "";
        public string TituloNovo { get; set; } = "";
        public string VencimentoNovo { get; set; } = "";
        public string ClasseNova { get; set; } = "TESOURO";
        public string Data { get; set; } = "";
        public string Tipo { get; set; } = "APLICACAO";
        public string Quantidade { get; set; } = "";
        public string Preco { get; set; } = "";
        public string Taxas { get; set; } = "";
    }
}
