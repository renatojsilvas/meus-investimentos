@page "/carteira"
@using Microsoft.EntityFrameworkCore
@inject CarteiraDbContext Db

<p><a href="/lancar">Lançar operação</a></p>

<h3>Carteira</h3>

@if (_snapshot is null)
{
    <p>Carregando...</p>
}
else
{
    @((MarkupString)_graficoSvg)
    <p>@_linhaResumo</p>
    <p>@_linhaCdi</p>

    if (_snapshot.TemPosicaoSemPreco)
    {
        <p><strong>Atenção:</strong> há posições sem preço na data de hoje.</p>
    }

    @foreach (var grupo in _grupos)
    {
        <h4>@grupo.NomeTitular</h4>
        <table border="1">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Quantidade</th>
                    <th>Custo</th>
                    <th>Preço</th>
                    <th>Valor</th>
                    <th>Rentabilidade (R$)</th>
                    <th>Rentabilidade (%)</th>
                    <th>Resultado realizado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in grupo.Posicoes)
                {
                    <tr>
                        <td>@p.Nome</td>
                        <td>@Formato.Numero(p.Quantidade)</td>
                        <td>@Formato.Moeda(p.Custo)</td>
                        <td>@(p.Preco is null ? "sem preço" : Formato.Moeda(p.Preco.Value))</td>
                        <td>@(p.ValorMercado is null ? "sem preço" : Formato.Moeda(p.ValorMercado.Value))</td>
                        <td>@(p.Rentabilidade is null ? "sem preço" : Formato.Moeda(p.Rentabilidade.Value))</td>
                        <td>@(p.RentabilidadePercentual is null ? "sem preço" : Formato.Percentual(p.RentabilidadePercentual.Value))</td>
                        <td>@Formato.Moeda(p.ResultadoRealizado)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td><strong>Subtotal</strong></td>
                    <td></td>
                    <td><strong>@Formato.Moeda(grupo.Custo)</strong></td>
                    <td></td>
                    <td><strong>@Formato.Moeda(grupo.Valor)</strong></td>
                    <td><strong>@Formato.Moeda(grupo.Rentabilidade)</strong></td>
                    <td><strong>@Formato.Percentual(grupo.RentabilidadePercentual)</strong></td>
                    <td><strong>@Formato.Moeda(grupo.ResultadoRealizado)</strong></td>
                </tr>
            </tfoot>
        </table>
    }

    <h4>Consolidado por título (todos os titulares)</h4>
    <table border="1">
        <thead>
            <tr>
                <th>Título</th>
                <th>Quantidade</th>
                <th>Custo</th>
                <th>Preço</th>
                <th>Valor</th>
                <th>Rentabilidade (R$)</th>
                <th>Rentabilidade (%)</th>
                <th>Resultado realizado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in _consolidado)
            {
                <tr>
                    <td>@c.Nome</td>
                    <td>@Formato.Numero(c.Quantidade)</td>
                    <td>@Formato.Moeda(c.Custo)</td>
                    <td>@(c.Preco is null ? "sem preço" : Formato.Moeda(c.Preco.Value))</td>
                    <td>@(c.Valor is null ? "sem preço" : Formato.Moeda(c.Valor.Value))</td>
                    <td>@(c.Rentabilidade is null ? "sem preço" : Formato.Moeda(c.Rentabilidade.Value))</td>
                    <td>@(c.RentabilidadePercentual is null ? "sem preço" : Formato.Percentual(c.RentabilidadePercentual.Value))</td>
                    <td>@Formato.Moeda(c.ResultadoRealizado)</td>
                </tr>
            }
        </tbody>
    </table>

    <h4>Total geral</h4>
    <table border="1">
        <tbody>
            <tr><td>Custo</td><td>@Formato.Moeda(_snapshot.CustoTotal)</td></tr>
            <tr><td>Valor</td><td>@Formato.Moeda(_snapshot.ValorTotal)</td></tr>
            <tr><td>Rentabilidade (R$)</td><td>@Formato.Moeda(_snapshot.RentabilidadeTotal)</td></tr>
            <tr><td>Rentabilidade (%)</td><td>@Formato.Percentual(_snapshot.RentabilidadePercentual)</td></tr>
            <tr><td>Resultado realizado</td><td>@Formato.Moeda(_snapshot.ResultadoRealizadoTotal)</td></tr>
        </tbody>
    </table>
}

@code {
    private CarteiraSnapshot? _snapshot;
    private List<GrupoTitular> _grupos = [];
    private List<ConsolidadoTitulo> _consolidado = [];
    private string _graficoSvg = "";
    private string _linhaResumo = "";
    private string _linhaCdi = "";

    protected override async Task OnInitializedAsync()
    {
        var titulares = await Db.Titulares.ToListAsync();
        var ativos = await Db.Ativos.ToListAsync();
        var operacoes = await Db.Operacoes.ToListAsync();
        var precos = await Db.PrecosDiarios.ToListAsync();

        var dataReferencia = Relogio.HojeSaoPaulo();

        _snapshot = PositionCalculator.Calculate(titulares, ativos, operacoes, precos, dataReferencia);

        _grupos = _snapshot.Posicoes
            .GroupBy(p => (p.TitularId, p.NomeTitular))
            .OrderBy(g => g.Key.NomeTitular)
            .Select(g =>
            {
                var posicoes = g.ToList();
                var (custo, _, valor, rentabilidade, rentabilidadePercentual, resultadoRealizado) = SomarPosicoes(posicoes);

                return new GrupoTitular(
                    g.Key.NomeTitular,
                    posicoes,
                    custo,
                    valor,
                    rentabilidade,
                    rentabilidadePercentual,
                    resultadoRealizado);
            })
            .ToList();

        _consolidado = _snapshot.Posicoes
            .GroupBy(p => (p.AtivoId, p.Nome))
            .OrderBy(g => g.Key.Nome)
            .Select(g =>
            {
                var posicoes = g.ToList();
                var comPreco = posicoes.Where(p => p.Preco is not null).ToList();
                var quantidade = posicoes.Sum(p => p.Quantidade);
                var (custo, _, valorSoma, rentabilidadeSoma, rentabilidadePercentualSoma, resultadoRealizado) = SomarPosicoes(posicoes);

                decimal? preco = null;
                decimal? valor = null;
                decimal? rentabilidade = null;
                decimal? rentabilidadePercentual = null;

                if (comPreco.Count > 0)
                {
                    preco = comPreco[0].Preco;
                    valor = valorSoma;
                    rentabilidade = rentabilidadeSoma;
                    rentabilidadePercentual = rentabilidadePercentualSoma;
                }

                return new ConsolidadoTitulo(
                    g.Key.Nome,
                    quantidade,
                    custo,
                    preco,
                    valor,
                    rentabilidade,
                    rentabilidadePercentual,
                    resultadoRealizado);
            })
            .ToList();

        var snapshotsDiarios = await Db.Snapshots.OrderBy(s => s.Data).ToListAsync();
        _graficoSvg = GraficoSvg.Gerar(snapshotsDiarios, titulares);

        _linhaResumo = $"Valor hoje {Formato.Moeda(_snapshot.ValorTotal)} · Custo {Formato.Moeda(_snapshot.CustoTotal)} · " +
                        $"Rentabilidade {Formato.Moeda(_snapshot.RentabilidadeTotal)} ({Formato.Percentual(_snapshot.RentabilidadePercentual)})";

        var snapshotsHoje = snapshotsDiarios.Where(s => s.Data == dataReferencia).ToList();
        if (snapshotsHoje.Count == 0 || snapshotsHoje.Any(s => s.ValorCdi is null))
        {
            _linhaCdi = "Se fosse CDI: sem dado";
        }
        else
        {
            var valorCdiHoje = snapshotsHoje.Sum(s => s.ValorCdi!.Value);

            var depositos = operacoes
                .Where(o => o.Tipo == TipoOperacao.Aplicacao && o.Data <= dataReferencia)
                .Sum(o => o.Quantidade * o.PrecoUnitario + o.Taxas);
            var saques = operacoes
                .Where(o => o.Tipo == TipoOperacao.Resgate && o.Data <= dataReferencia)
                .Sum(o => o.Quantidade * o.PrecoUnitario - o.Taxas);
            var caixa = depositos - saques;

            var denominador = valorCdiHoje - caixa;
            var percentualTexto = denominador <= 0
                ? "—"
                : Formato.Percentual((_snapshot.ValorTotal - caixa) / denominador);

            _linhaCdi = $"Se fosse CDI: R$ {Formato.Moeda(valorCdiHoje)} · Carteira rendeu {percentualTexto} do CDI";
        }
    }

    private static (decimal Custo, decimal CustoComPreco, decimal Valor, decimal Rentabilidade, decimal RentabilidadePercentual, decimal ResultadoRealizado) SomarPosicoes(List<PosicaoSnapshot> posicoes)
    {
        var comPreco = posicoes.Where(p => p.Preco is not null).ToList();
        var custo = posicoes.Sum(p => p.Custo);
        var custoComPreco = comPreco.Sum(p => p.Custo);
        var valor = comPreco.Sum(p => p.ValorMercado ?? 0);
        var rentabilidade = comPreco.Sum(p => p.Rentabilidade ?? 0);
        var rentabilidadePercentual = custoComPreco == 0 ? 0 : rentabilidade / custoComPreco;
        var resultadoRealizado = posicoes.Sum(p => p.ResultadoRealizado);

        return (custo, custoComPreco, valor, rentabilidade, rentabilidadePercentual, resultadoRealizado);
    }

    private record GrupoTitular(
        string NomeTitular,
        List<PosicaoSnapshot> Posicoes,
        decimal Custo,
        decimal Valor,
        decimal Rentabilidade,
        decimal RentabilidadePercentual,
        decimal ResultadoRealizado);

    private record ConsolidadoTitulo(
        string Nome,
        decimal Quantidade,
        decimal Custo,
        decimal? Preco,
        decimal? Valor,
        decimal? Rentabilidade,
        decimal? RentabilidadePercentual,
        decimal ResultadoRealizado);
}
