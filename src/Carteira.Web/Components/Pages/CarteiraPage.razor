@page "/carteira"
@using System.Globalization
@using System.Text
@using Microsoft.EntityFrameworkCore
@inject CarteiraDbContext Db

<h3>Carteira</h3>

@if (_snapshot is null)
{
    <p>Carregando...</p>
}
else
{
    @((MarkupString)_graficoSvg)
    <p>@_linhaResumo</p>

    if (_snapshot.TemPosicaoSemPreco)
    {
        <p><strong>Atenção:</strong> há posições sem preço na data de hoje.</p>
    }

    @foreach (var grupo in _grupos)
    {
        <h4>@grupo.NomeTitular</h4>
        <table border="1">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Quantidade</th>
                    <th>Custo</th>
                    <th>Preço</th>
                    <th>Valor</th>
                    <th>Rentabilidade (R$)</th>
                    <th>Rentabilidade (%)</th>
                    <th>Resultado realizado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in grupo.Posicoes)
                {
                    <tr>
                        <td>@p.Nome</td>
                        <td>@FormatNumero(p.Quantidade)</td>
                        <td>@FormatMoeda(p.Custo)</td>
                        <td>@(p.Preco is null ? "sem preço" : FormatMoeda(p.Preco.Value))</td>
                        <td>@(p.ValorMercado is null ? "sem preço" : FormatMoeda(p.ValorMercado.Value))</td>
                        <td>@(p.Rentabilidade is null ? "sem preço" : FormatMoeda(p.Rentabilidade.Value))</td>
                        <td>@(p.RentabilidadePercentual is null ? "sem preço" : FormatPercentual(p.RentabilidadePercentual.Value))</td>
                        <td>@FormatMoeda(p.ResultadoRealizado)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td><strong>Subtotal</strong></td>
                    <td></td>
                    <td><strong>@FormatMoeda(grupo.Custo)</strong></td>
                    <td></td>
                    <td><strong>@FormatMoeda(grupo.Valor)</strong></td>
                    <td><strong>@FormatMoeda(grupo.Rentabilidade)</strong></td>
                    <td><strong>@FormatPercentual(grupo.RentabilidadePercentual)</strong></td>
                    <td><strong>@FormatMoeda(grupo.ResultadoRealizado)</strong></td>
                </tr>
            </tfoot>
        </table>
    }

    <h4>Consolidado por título (todos os titulares)</h4>
    <table border="1">
        <thead>
            <tr>
                <th>Título</th>
                <th>Quantidade</th>
                <th>Custo</th>
                <th>Preço</th>
                <th>Valor</th>
                <th>Rentabilidade (R$)</th>
                <th>Rentabilidade (%)</th>
                <th>Resultado realizado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in _consolidado)
            {
                <tr>
                    <td>@c.Nome</td>
                    <td>@FormatNumero(c.Quantidade)</td>
                    <td>@FormatMoeda(c.Custo)</td>
                    <td>@(c.Preco is null ? "sem preço" : FormatMoeda(c.Preco.Value))</td>
                    <td>@(c.Valor is null ? "sem preço" : FormatMoeda(c.Valor.Value))</td>
                    <td>@(c.Rentabilidade is null ? "sem preço" : FormatMoeda(c.Rentabilidade.Value))</td>
                    <td>@(c.RentabilidadePercentual is null ? "sem preço" : FormatPercentual(c.RentabilidadePercentual.Value))</td>
                    <td>@FormatMoeda(c.ResultadoRealizado)</td>
                </tr>
            }
        </tbody>
    </table>

    <h4>Total geral</h4>
    <table border="1">
        <tbody>
            <tr><td>Custo</td><td>@FormatMoeda(_snapshot.CustoTotal)</td></tr>
            <tr><td>Valor</td><td>@FormatMoeda(_snapshot.ValorTotal)</td></tr>
            <tr><td>Rentabilidade (R$)</td><td>@FormatMoeda(_snapshot.RentabilidadeTotal)</td></tr>
            <tr><td>Rentabilidade (%)</td><td>@FormatPercentual(_snapshot.RentabilidadePercentual)</td></tr>
            <tr><td>Resultado realizado</td><td>@FormatMoeda(_snapshot.ResultadoRealizadoTotal)</td></tr>
        </tbody>
    </table>
}

@code {
    private static readonly CultureInfo PtBr = CultureInfo.GetCultureInfo("pt-BR");

    // Cores fixas do gráfico, uma por titular (na ordem alfabética do nome); o total usa _corTotal.
    private static readonly string[] CoresSeries = ["#1b9e77", "#d95f02", "#7570b3", "#e7298a"];
    private const string CorTotal = "#333333";
    private const string CorEixo = "#999999";

    private CarteiraSnapshot? _snapshot;
    private List<GrupoTitular> _grupos = [];
    private List<ConsolidadoTitulo> _consolidado = [];
    private string _graficoSvg = "";
    private string _linhaResumo = "";

    protected override async Task OnInitializedAsync()
    {
        var titulares = await Db.Titulares.ToListAsync();
        var ativos = await Db.Ativos.ToListAsync();
        var operacoes = await Db.Operacoes.ToListAsync();
        var precos = await Db.PrecosDiarios.ToListAsync();

        var dataReferencia = Relogio.HojeSaoPaulo();

        _snapshot = PositionCalculator.Calculate(titulares, ativos, operacoes, precos, dataReferencia);

        _grupos = _snapshot.Posicoes
            .GroupBy(p => (p.TitularId, p.NomeTitular))
            .OrderBy(g => g.Key.NomeTitular)
            .Select(g =>
            {
                var posicoes = g.ToList();
                var comPreco = posicoes.Where(p => p.Preco is not null).ToList();
                var custo = posicoes.Sum(p => p.Custo);
                var custoComPreco = comPreco.Sum(p => p.Custo);
                var valor = comPreco.Sum(p => p.ValorMercado ?? 0);
                var rentabilidade = comPreco.Sum(p => p.Rentabilidade ?? 0);
                var rentabilidadePercentual = custoComPreco == 0 ? 0 : rentabilidade / custoComPreco;
                var resultadoRealizado = posicoes.Sum(p => p.ResultadoRealizado);

                return new GrupoTitular(
                    g.Key.NomeTitular,
                    posicoes,
                    custo,
                    valor,
                    rentabilidade,
                    rentabilidadePercentual,
                    resultadoRealizado);
            })
            .ToList();

        _consolidado = _snapshot.Posicoes
            .GroupBy(p => (p.AtivoId, p.Nome))
            .OrderBy(g => g.Key.Nome)
            .Select(g =>
            {
                var posicoes = g.ToList();
                var comPreco = posicoes.Where(p => p.Preco is not null).ToList();
                var quantidade = posicoes.Sum(p => p.Quantidade);
                var custo = posicoes.Sum(p => p.Custo);
                var resultadoRealizado = posicoes.Sum(p => p.ResultadoRealizado);

                decimal? preco = null;
                decimal? valor = null;
                decimal? rentabilidade = null;
                decimal? rentabilidadePercentual = null;

                if (comPreco.Count > 0)
                {
                    preco = comPreco[0].Preco;
                    var custoComPreco = comPreco.Sum(p => p.Custo);
                    valor = comPreco.Sum(p => p.ValorMercado ?? 0);
                    rentabilidade = comPreco.Sum(p => p.Rentabilidade ?? 0);
                    rentabilidadePercentual = custoComPreco == 0 ? 0 : rentabilidade / custoComPreco;
                }

                return new ConsolidadoTitulo(
                    g.Key.Nome,
                    quantidade,
                    custo,
                    preco,
                    valor,
                    rentabilidade,
                    rentabilidadePercentual,
                    resultadoRealizado);
            })
            .ToList();

        var snapshotsDiarios = await Db.Snapshots.OrderBy(s => s.Data).ToListAsync();
        _graficoSvg = MontarGraficoSvg(snapshotsDiarios, titulares);

        _linhaResumo = $"Valor hoje {FormatMoeda(_snapshot.ValorTotal)} · Custo {FormatMoeda(_snapshot.CustoTotal)} · " +
                        $"Rentabilidade {FormatMoeda(_snapshot.RentabilidadeTotal)} ({FormatPercentual(_snapshot.RentabilidadePercentual)})";
    }

    // Lê daily_snapshots (já preenchido pelo job) e desenha um SVG estático: uma <polyline> por
    // titular (quebrada onde o titular não tem ponto) e uma para o total (soma dos titulares por
    // dia). Não chama DailySeries.Build — a série vem do cache.
    private static string MontarGraficoSvg(List<SnapshotDiario> snapshots, List<Titular> titulares)
    {
        const double vbWidth = 1000;
        const double vbHeight = 340;

        if (snapshots.Count == 0)
        {
            return $"<svg width=\"100%\" height=\"340\" viewBox=\"0 0 {Fmt(vbWidth)} {Fmt(vbHeight)}\" xmlns=\"http://www.w3.org/2000/svg\">" +
                   $"<text x=\"20\" y=\"20\" font-size=\"12\" fill=\"{CorEixo}\">Sem dados suficientes para o gráfico ainda.</text></svg>";
        }

        const double plotLeft = 60;
        const double plotRight = vbWidth - 20;
        const double plotTop = 20;
        const double plotBottom = 190;
        const double xLabelY = plotBottom + 20;
        const double legendaY0 = 250;
        const double legendaPasso = 18;

        var nomesPorId = titulares.ToDictionary(t => t.Id, t => t.Nome);

        var datas = snapshots.Select(s => s.Data).Distinct().OrderBy(d => d).ToList();
        var indicePorData = datas.Select((d, i) => (d, i)).ToDictionary(x => x.d, x => x.i);

        var porTitular = snapshots
            .GroupBy(s => s.TitularId)
            .Select(g => new
            {
                Nome = nomesPorId.GetValueOrDefault(g.Key, g.Key.ToString()),
                Pontos = g.OrderBy(s => s.Data).ToList()
            })
            .OrderBy(g => g.Nome)
            .ToList();

        var totalPorData = snapshots
            .GroupBy(s => s.Data)
            .OrderBy(g => g.Key)
            .Select(g => (Data: g.Key, Valor: g.Sum(s => s.Valor)))
            .ToList();

        var minData = datas[0];
        var maxData = datas[^1];
        var maiorTotal = totalPorData.Count == 0 ? 0m : totalPorData.Max(t => t.Valor);
        var escalaValor = maiorTotal <= 0 ? 1m : maiorTotal;

        double X(DateOnly d)
        {
            if (maxData == minData)
                return plotLeft;
            var total = maxData.DayNumber - minData.DayNumber;
            var pos = d.DayNumber - minData.DayNumber;
            return plotLeft + (plotRight - plotLeft) * pos / total;
        }

        double Y(decimal valor)
        {
            var fracao = (double)(valor / escalaValor);
            return plotBottom - fracao * (plotBottom - plotTop);
        }

        var sb = new StringBuilder();
        sb.Append($"<svg width=\"100%\" height=\"340\" viewBox=\"0 0 {Fmt(vbWidth)} {Fmt(vbHeight)}\" xmlns=\"http://www.w3.org/2000/svg\">");

        // eixos
        sb.Append($"<line x1=\"{Fmt(plotLeft)}\" y1=\"{Fmt(plotTop)}\" x2=\"{Fmt(plotLeft)}\" y2=\"{Fmt(plotBottom)}\" stroke=\"{CorEixo}\" />");
        sb.Append($"<line x1=\"{Fmt(plotLeft)}\" y1=\"{Fmt(plotBottom)}\" x2=\"{Fmt(plotRight)}\" y2=\"{Fmt(plotBottom)}\" stroke=\"{CorEixo}\" />");

        // rótulos de valor no eixo Y (5: 0, 1/4, 1/2, 3/4, máximo do total)
        for (var i = 0; i <= 4; i++)
        {
            var valor = maiorTotal * i / 4;
            var y = Y(valor);
            sb.Append($"<text x=\"{Fmt(plotLeft - 8)}\" y=\"{Fmt(y + 4)}\" text-anchor=\"end\" font-size=\"11\" fill=\"{CorTotal}\">{valor.ToString("N0", PtBr)}</text>");
        }

        // rótulos de data no eixo X (até 5, espalhados pelas datas existentes)
        var qtdRotulosX = Math.Min(5, datas.Count);
        for (var i = 0; i < qtdRotulosX; i++)
        {
            var idx = qtdRotulosX == 1 ? 0 : i * (datas.Count - 1) / (qtdRotulosX - 1);
            var data = datas[idx];
            var x = X(data);
            sb.Append($"<text x=\"{Fmt(x)}\" y=\"{Fmt(xLabelY)}\" text-anchor=\"middle\" font-size=\"11\" fill=\"{CorTotal}\">{data:dd/MM/yy}</text>");
        }

        // linha do total (sempre contínua: soma dos titulares presentes em cada data)
        var pontosTotal = string.Join(" ", totalPorData.Select(t => $"{Fmt(X(t.Data))},{Fmt(Y(t.Valor))}"));
        sb.Append($"<polyline points=\"{pontosTotal}\" fill=\"none\" stroke=\"{CorTotal}\" stroke-width=\"2\" />");

        // uma linha por titular, quebrada onde não há ponto (R9: começa na primeira aplicação,
        // interrompe no buraco, retoma se o titular voltar a aplicar)
        for (var i = 0; i < porTitular.Count; i++)
        {
            var serie = porTitular[i];
            var cor = CoresSeries[i % CoresSeries.Length];

            var segmento = new List<SnapshotDiario>();
            int? indiceAnterior = null;

            foreach (var ponto in serie.Pontos)
            {
                var indiceAtual = indicePorData[ponto.Data];
                if (indiceAnterior is not null && indiceAtual != indiceAnterior + 1)
                {
                    EmitirSegmento(sb, segmento, cor, X, Y);
                    segmento = [];
                }

                segmento.Add(ponto);
                indiceAnterior = indiceAtual;
            }

            EmitirSegmento(sb, segmento, cor, X, Y);

            // legenda: um pequeno traço na cor da série + o nome do titular
            var y = legendaY0 + i * legendaPasso;
            sb.Append($"<line x1=\"{Fmt(plotLeft)}\" y1=\"{Fmt(y)}\" x2=\"{Fmt(plotLeft + 20)}\" y2=\"{Fmt(y)}\" stroke=\"{cor}\" stroke-width=\"2\" />");
            sb.Append($"<text x=\"{Fmt(plotLeft + 28)}\" y=\"{Fmt(y + 4)}\" font-size=\"12\" fill=\"{CorTotal}\">{System.Net.WebUtility.HtmlEncode(serie.Nome)}</text>");
        }

        var yTotalLegenda = legendaY0 + porTitular.Count * legendaPasso;
        sb.Append($"<line x1=\"{Fmt(plotLeft)}\" y1=\"{Fmt(yTotalLegenda)}\" x2=\"{Fmt(plotLeft + 20)}\" y2=\"{Fmt(yTotalLegenda)}\" stroke=\"{CorTotal}\" stroke-width=\"2\" />");
        sb.Append($"<text x=\"{Fmt(plotLeft + 28)}\" y=\"{Fmt(yTotalLegenda + 4)}\" font-size=\"12\" fill=\"{CorTotal}\">Total</text>");

        sb.Append("</svg>");
        return sb.ToString();
    }

    private static void EmitirSegmento(
        StringBuilder sb,
        List<SnapshotDiario> segmento,
        string cor,
        Func<DateOnly, double> x,
        Func<decimal, double> y)
    {
        if (segmento.Count < 2)
            return;

        var pontos = string.Join(" ", segmento.Select(p => $"{Fmt(x(p.Data))},{Fmt(y(p.Valor))}"));
        sb.Append($"<polyline points=\"{pontos}\" fill=\"none\" stroke=\"{cor}\" stroke-width=\"2\" />");
    }

    private static string Fmt(double valor) => valor.ToString("0.##", CultureInfo.InvariantCulture);

    private static string FormatMoeda(decimal valor) => valor.ToString("N2", PtBr);

    private static string FormatNumero(decimal valor) => valor.ToString("N2", PtBr);

    private static string FormatPercentual(decimal fracao) => (fracao * 100).ToString("N2", PtBr) + "%";

    private record GrupoTitular(
        string NomeTitular,
        List<PosicaoSnapshot> Posicoes,
        decimal Custo,
        decimal Valor,
        decimal Rentabilidade,
        decimal RentabilidadePercentual,
        decimal ResultadoRealizado);

    private record ConsolidadoTitulo(
        string Nome,
        decimal Quantidade,
        decimal Custo,
        decimal? Preco,
        decimal? Valor,
        decimal? Rentabilidade,
        decimal? RentabilidadePercentual,
        decimal ResultadoRealizado);
}
